# Databases (created by CLI, never committed)
database/*.sqlite
database/*.sqlite-shm
database/*.sqlite-wal
database/*.sqlite3

# Raw evidence storage is never committed
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

# Generated reports (the public export in data/public/ IS committed since the
# data-collection stage began — it is the publishable dataset)
data/interim/quality_report.json

# Environment
.env
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
